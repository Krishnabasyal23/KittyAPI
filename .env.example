# Copy to .env.local for a local run, or set these as environment variables on a host.
# Never commit the real file.

# Switch on the protection for a server that is reachable from the internet.
PUBLIC_MODE=1

# The public address phones should use (put into the join QR code), no trailing slash.
PUBLIC_URL=https://your-catino-address.example.com

# Keys: use long random values (python -c "import secrets; print(secrets.token_hex(24))").
TICKET_SECRET=
QR_SECRET=

# Where the database lives. On a host this must be a persistent disk.
# KITTY_DB_PATH=/data/catino-v2.db

# Points-only simulated purchases on a public server (off unless you set both).
# DEMO_MODE=1
# ALLOW_PUBLIC_DEMO=1

# Browser origins allowed to call the API from another site (comma separated). Not needed for /crowd.
# CORS_ORIGINS=

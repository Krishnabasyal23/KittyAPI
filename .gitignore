__pycache__/
# SQLite database files
data/*.db
data/*.db-wal
data/*.db-shm
*.db-journal

# Any database file, anywhere (v1 data and v2 test/temp databases stay local)
*.db
*.sqlite
*.sqlite3

# Secrets and certificates
.env
.env.*
*.pem
*.key
*.pfx
*.keystore
certs/

# Tool output and scratch space
*.log
.tmp/
.pytest_cache/
web/

# Database backups made by database/migrate.py before an upgrade
*.bak
